# ---- secrets & local state: never commit ------------------------------------
.env
.env.*
!.env.example
secrets.json
twitter-cookies.txt
cookies.txt
*.key
*.pem
# the updater signing key, if someone generates it into the repo by mistake
curio.key*

# ---- the archive (browser-mode Docker default) and any db ------------------
data/
*.db
*.db-wal
*.db-shm
*.bak

# ---- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
reaver/.build/
deliverer/.build/            # PyInstaller work/dist for the sidecar

# ---- node / pnpm ------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
package-lock.json            # pnpm workspace: never npm
yarn.lock

# ---- vite / vue ---------------------------------------------------------------
deliverer/dist/
deliverer/coverage/
deliverer/.vite/
*.tsbuildinfo
# generated by unplugin on every dev/build — committed on purpose, do NOT ignore:
#   deliverer/src/auto-imports.d.ts, deliverer/src/components.d.ts,
#   deliverer/.eslintrc-auto-import.json

# ---- tauri / rust -------------------------------------------------------------
deliverer/src-tauri/target/
deliverer/src-tauri/gen/schemas/
deliverer/src-tauri/resources/sidecar/   # build output of build-sidecar.sh
# icons are generated by `pnpm tauri icon` from a source png — commit them

# ---- docker -------------------------------------------------------------------
docker-compose.override.yml

# ---- editors / os -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~

# ---- binaries: ignore by type anywhere, allow only where they belong ---------
# Curio downloads images for a living; a library root pointed inside the repo
# must not turn into a 3 GB commit. Installers and archives never belong here.
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.avif
*.bmp
*.psd
*.mp4
*.webm
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.dmg
*.pkg
*.exe
*.msi
*.AppImage
*.deb
*.rpm
*.app/
*.woff
*.woff2
*.ttf
*.otf
# ...except the app icons and documentation images
!deliverer/src-tauri/icons/*.png
!deliverer/src-tauri/icons/*.icns
!deliverer/src-tauri/icons/*.ico
!docs/images/**

# ---- scratch ----------------------------------------------------------------
_to_delete/
*.log
/tmp/
